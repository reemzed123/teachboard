{
  "name": "teachboard",
  "private": true,
  "version": "0.0.1",
  "description": "TeachBoard – סביבת הוראה דיגיטלית למורים",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm assets && vite",
    "build": "pnpm assets && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:licenses && pnpm build && pnpm test:e2e",
    "assets": "node scripts/copy-math-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "5.3.0",
    "dexie": "4.4.7",
    "fflate": "0.8.3",
    "jsxgraph": "1.14.3",
    "konva": "10.11.0",
    "lucide-react": "1.80.0",
    "mathjax-full": "3.2.2",
    "mathlive": "0.111.4",
    "pdf-lib": "1.17.1",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "workbox-window": "7.4.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.7",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.2",
    "workbox-build": "7.4.1"
  }
}
