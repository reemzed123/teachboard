{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeachBoard",
  "version": "../package.json",
  "identifier": "com.teachboard.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TeachBoard",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "TeachBoard",
    "copyright": "© TeachBoard. כל הזכויות שמורות.",
    "shortDescription": "סביבת הוראה דיגיטלית למורים",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["board"],
        "name": "TeachBoard Lesson",
        "description": "שיעור TeachBoard",
        "mimeType": "application/x-teachboard",
        "role": "Editor"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Hebrew", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
